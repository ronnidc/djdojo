#!/usr/bin/env bash
# djdojo - turn your YouTube or SoundCloud playlist into lossless AIFF or FLAC for DJ practice.
# Usage: djdojo PLAYLIST_URL_OR_ID [...] [aiff|flac] [chrome|safari|firefox|nologin]
set -euo pipefail

version=1.2.0

# Settings: format and folder, chosen the first time djdojo runs in a terminal (setup, further
# down), and the login, which the user adds by hand. The file is the user's own and survives
# updates of djdojo. Run without a terminal, for example from another script, the defaults are
# used without asking.
config=~/.config/djdojo/config
format=aiff
dest=~/Music/djdojo
login_config=  # "no" or a browser name. Empty = search the browsers.

# The browsers yt-dlp can read cookies from, as a word on the command line or in the settings file
browsers='brave|chrome|chromium|edge|firefox|opera|safari|vivaldi|whale'

# Takes the file as it is. The values are checked where they are used, so --help can show the
# stored default without failing on a bad value.
read_config() {
  local line key value
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == \#* || $line != *=* ]] && continue
    key=$(printf '%s' "${line%%=*}" | tr -d '[:space:]')
    value=${line#*=}
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    case $key in
      format) format=$value ;;
      folder) dest=${value/#\~/$HOME} ;;
      login) login_config=$value ;;
    esac
  done < "$config"
}

# The help text marks the stored default format, or aiff before the first run
usage() {
  local aiff_default='' flac_default=''
  if [[ -f $config ]]; then
    read_config
  fi
  case $format in
    aiff) aiff_default=" (default)" ;;
    flac) flac_default=" (default)" ;;
  esac
  cat <<EOF
Usage: djdojo PLAYLIST [aiff|flac] [chrome|safari|firefox|nologin] [verbose] [yt-dlp options ...]

Turns your YouTube or SoundCloud playlist into lossless audio files for DJ practice, the whole playlist in one folder.
For private practice with music you have the right to download. For public or professional use, buy the music.

  PLAYLIST    YouTube playlist link or just its ID (the part after list=), or SoundCloud link, a single track works too
  aiff        plays on every deck and DJ app, even the oldest CDJs, about 10 MB per minute$aiff_default
  flac        same audio at half the size, Pioneer decks need CDJ-2000NXS2, XDJ-1000MK2 or newer$flac_default
  chrome ...  YouTube or SoundCloud login from that browser. Without one, Firefox, Safari and Chrome are tried
  nologin     without login, so without YouTube's Premium audio and SoundCloud's original files
  verbose     shows everything yt-dlp says, instead of one line per track

The default format and folder are chosen on the first run and stored in ~/.config/djdojo/config.
Edit the file, or delete it to be asked again. The file can also hold the login: login=no, a
browser name such as login=firefox, or one profile of a browser such as login=chrome:Profile 1.
EOF
}

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 1
fi
for a in "$@"; do
  case $a in
    -h|--help) usage; exit 0 ;;
    --version) echo "djdojo $version"; exit 0 ;;
  esac
done

# The command as it was typed, for the hints that suggest running it again with one word more
rerun="djdojo $*"

files() {
  if [[ $1 == 1 ]]; then echo file; else echo files; fi
}

upper() {
  printf '%s' "$1" | tr '[:lower:]' '[:upper:]'
}

# Path with ~ for the home folder, for display only
pretty() {
  case $1 in
    "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# How djdojo's own lines look. In a terminal each starts with the name and a mark for its kind, in
# bold and in the kind's color, so they stand out between yt-dlp's many lines:
#   → doing something   • information   ✓ went well   ! needs attention   ✗ failed
# What went well, needs attention or failed is colored all the way, and what djdojo is doing is
# bold, so the outcome can be read off the colors alone. Information keeps the terminal's own
# color, which every theme makes readable.
# Anywhere else (a pipe, a file, CI) a line is plain "djdojo: text", as it always was, so whatever
# reads the output keeps working. NO_COLOR (https://no-color.org) keeps the marks and drops the
# colors. Where the locale is not UTF-8 the marks are ASCII.
styled=no
bold='' dim='' cyan='' green='' yellow='' red='' plain=''
if [[ -t 2 && ${TERM:-dumb} != dumb ]]; then
  styled=yes
  if [[ -z ${NO_COLOR:-} ]]; then
    bold=$'\033[1m' dim=$'\033[2m' cyan=$'\033[36m' green=$'\033[32m' yellow=$'\033[33m'
    red=$'\033[31m' plain=$'\033[0m'
  fi
fi
case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
  *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) marks=('→' '•' '✓' '!' '✗') ;;
  *) marks=('>' '-' '+' '!' 'x') ;;
esac

# An aside is information that is only there to be found when it is needed, so the whole line is
# toned down.
# Usage: msg step|note|aside|ok|warn|err TEXT
msg() {
  local mark name text
  if [[ $styled == no ]]; then
    echo "djdojo: $2" >&2
    return
  fi
  case $1 in
    step) mark=${marks[0]} name=$bold$cyan text=$bold ;;
    note) mark=${marks[1]} name=$bold text='' ;;
    aside) mark=${marks[1]} name=$dim text=$dim ;;
    ok) mark=${marks[2]} name=$bold$green text=$green ;;
    warn) mark=${marks[3]} name=$bold$yellow text=$yellow ;;
    *) mark=${marks[4]} name=$bold$red text=$red ;;
  esac
  echo "${name}djdojo ${mark}${plain} ${text}$2${plain}" >&2
}

# A browser name becomes --cookies-from-browser, so yt-dlp uses your login from there. One profile
# of the browser is named after a colon, as in "chrome:Profile 1".
# Bare IDs become full URLs. Video: 11 characters, but not starting with a dash, which an
# 11-character yt-dlp option like --dump-json does. Playlist: PL own, OL album, RD mix, UU channel
# uploads, FL/LL/WL/LM favorites, likes, watch later and YouTube Music's "Liked Music".
# A leading "VL" is YouTube Music's browse ID for the same playlist and is cut off.
# music.youtube.com rather than www: with cookies yt-dlp then also asks YouTube Music's own
# client, which is the one that serves Premium's 256k audio. Without cookies it makes no difference.
args=()
prev=
login=  # browser name, "file" or "none". Empty = find a browser that is logged in.
format_arg=
view=calm  # one line per track, or "full": everything yt-dlp says, as it says it
for a in "$@"; do
  if [[ $prev == --cookies-from-browser ]]; then
    args+=("$a")
    login=$a
  elif [[ $a =~ ^($browsers)(:.+)?$ ]]; then
    args+=(--cookies-from-browser "$a")
    login=$a
  elif [[ $a == nologin ]]; then  # plain word for --no-cookies-from-browser, which still works
    args+=(--no-cookies-from-browser)
    login=none
  elif [[ $a == verbose ]]; then
    view=full
  elif [[ $a == aiff || $a == flac ]]; then
    format_arg=$a
  elif [[ $a != -* && $a =~ ^[0-9A-Za-z_-]{11}$ ]]; then
    args+=("https://music.youtube.com/watch?v=$a")
  elif [[ $a =~ ^(VL)?((PL|OL|RD|UU|FL|LL|WL|LM)[0-9A-Za-z_-]*)$ ]]; then
    args+=("https://music.youtube.com/playlist?list=${BASH_REMATCH[2]}")
  else
    case $a in
      --cookies) login="file" ;;
      --no-cookies-from-browser) login=none ;;
      -v|--verbose) view=full ;;  # yt-dlp's debug lines are asked for, so they are shown
    esac
    args+=("$a")
  fi
  prev=$a
done

# The first link's site decides the login search and the wording, since djdojo is for one
# playlist per run. Bare IDs are YouTube's, and SoundCloud's app shares on.soundcloud.com links.
site=youtube
for a in ${args[@]+"${args[@]}"}; do
  if [[ $a =~ ^(https?://)?([0-9a-z-]+\.)?soundcloud\.com/ ]]; then
    site=soundcloud
    break
  elif [[ $a == *://* ]]; then
    break
  fi
done
# What a login adds. SoundCloud hands the uploader's own file, often a WAV, only to logged-in users,
# and only for tracks whose uploader has enabled downloads.
case $site in
  youtube)
    site_name=YouTube
    site_url=music.youtube.com
    extras="Premium audio"
    extras_long="there is no Premium audio (about 256k, needs YouTube Premium)"
    premium=Premium
    ;;
  soundcloud)
    site_name=SoundCloud
    site_url=soundcloud.com
    extras="original files and Go+ audio"
    extras_long="there are no original files, which uploaders can offer for download, and no Go+ audio (256k, needs SoundCloud Go+)"
    premium=Go+
    ;;
esac

# The first-run questions. The answers go into the settings file, see the top of the script.
setup() {
  local answer
  msg note "First run. Two questions, the answers are stored in $(pretty "$config") and can be edited there."
  cat >&2 <<EOF

Format:
  1) AIFF - plays on every deck and DJ app, even the oldest CDJs, about 10 MB per minute
  2) FLAC - same audio at half the size, Pioneer decks need CDJ-2000NXS2, XDJ-1000MK2 or newer
EOF
  answer=
  read -r -p "Choose [1]: " answer || true
  case $answer in
    2|flac|FLAC) format=flac ;;
    *) format=aiff ;;
  esac
  answer=
  read -r -p "Folder for playlists [$(pretty "$dest")]: " answer || true
  if [[ -n $answer ]]; then
    dest=${answer/#\~/$HOME}
  fi
  mkdir -p "$(dirname "$config")"
  cat > "$config" <<EOF
# Settings for djdojo. Edit freely, or delete the file to be asked again.
format=$format
folder=$(pretty "$dest")
# login=no downloads without YouTube login, login=firefox always uses that browser
EOF
  msg ok "Saved in $(pretty "$config")."
  echo >&2
}

if [[ -f $config ]]; then
  read_config
  if [[ $format != aiff && $format != flac ]]; then
    msg err "Unknown format \"$format\" in $(pretty "$config"). Write aiff or flac."
    exit 1
  fi
  if [[ -n $login_config && $login_config != no && ! $login_config =~ ^($browsers)(:.+)?$ ]]; then
    msg err "Unknown login \"$login_config\" in $(pretty "$config"). Write no, a browser name such as firefox, or a browser and one of its profiles such as chrome:Profile 1."
    exit 1
  fi
elif [[ -t 0 ]]; then
  setup
fi
if [[ -n $format_arg ]]; then
  format=$format_arg
fi
# The login in the settings file counts when the command line named none
if [[ -z $login && -n $login_config ]]; then
  if [[ $login_config == no ]]; then
    login=none
    args+=(--no-cookies-from-browser)
  else
    login=$login_config
    args+=(--cookies-from-browser "$login_config")
  fi
fi

# What the format decides. AIFF: --extract-audio cannot make AIFF, hence --recode-video. Every
# AIFF becomes 16 bit/44.1 kHz, which even the oldest decks take. The conversion resamples straight
# from the decoder, since Opus is 48 kHz. --recode-video skips a file that already is AIFF, such as
# a SoundCloud original in 24 bit/48 kHz, so the metadata step, which runs on every file, converts
# once more. Audio that already is 16 bit/44.1 kHz passes it bit-exact. Tags as ID3 inside the AIFF,
# ffmpeg otherwise only writes AIFF's own fields, which have no artist. FLAC keeps the source as it
# is. Both keep the cover as a .jpg next to the file, and the script embeds it afterwards: yt-dlp
# cannot put a cover into an AIFF, and cannot scale one down for a FLAC.
case $format in
  aiff) format_args=(--recode-video aiff --ppa "VideoConvertor+ffmpeg_o:-ar 44100"
                     --ppa "Metadata+ffmpeg_o:-write_id3v2 1 -c:a pcm_s16be -ar 44100" --write-thumbnail) ;;
  flac) format_args=(--extract-audio --audio-format flac --write-thumbnail) ;;
esac
FORMAT=$(upper "$format")

# The first browser in the order that is logged in to the site, and every profile of it that is.
# A browser can hold several profiles, each with its own login, say a private and a school one.
# Named without a profile, yt-dlp reads the one whose cookies were written last, which with two
# windows open is either of them. Uses yt-dlp's own cookie reading and the same "logged in" rule
# as yt-dlp's code for the site. The Python that has yt-dlp's modules is the one in yt-dlp's own
# shebang, with Homebrew, pipx and pip alike.
# Usage: find_login SITE BROWSER ...
# Prints one line per logged-in profile, the most recently used first: the name to give
# --cookies-from-browser, a tab, and the name to show. Or one status line per browser and exit 1
# if none is logged in.
find_login() {
  local python
  python=$(sed -n '1s/^#! *//p' "$(readlink -f "$(command -v yt-dlp)")")
  if [[ ! -x $python ]]; then
    echo "  cannot check the browsers: yt-dlp's Python was not found. Name the browser yourself, for example: $rerun firefox"
    return 1
  fi
  "$python" - "$@" <<'PY'
import json
import os
import sys
from yt_dlp import cookies

class Logger:
    def __init__(self):
        self.errors = []
    def debug(self, *args, **kwargs):
        pass
    info = warning = debug
    def error(self, message, *args, **kwargs):
        self.errors.append(message)

# YouTube: LOGIN_INFO plus one of the SAPISID cookies. SoundCloud: the oauth_token cookie, which
# yt-dlp sends as the OAuth header.
AUTH = {'SAPISID', '__Secure-1PAPISID', '__Secure-3PAPISID'}
SITES = {
    'youtube': ('YouTube', 'youtube.com', lambda names: 'LOGIN_INFO' in names and bool(names & AUTH)),
    'soundcloud': ('SoundCloud', 'soundcloud.com', lambda names: 'oauth_token' in names),
}
label, domain, logged_in = SITES[sys.argv[1]]

def profiles(browser):
    """The browser's profile folders as (folder, name to show), the most recently used first.
    A single (None, None) when there are not several to choose from. That is also the answer
    when yt-dlp's private helpers, which this leans on, have changed: yt-dlp then picks the
    profile itself, as it did before djdojo looked at profiles."""
    try:
        names = {}
        if browser == 'firefox':
            roots = [os.path.abspath(root) for root in cookies._firefox_browser_dirs()]
            files = list(cookies._firefox_cookie_dbs(roots))
        elif browser == 'safari':
            return [(None, None)]
        else:
            settings = cookies._get_chromium_based_browser_settings(browser)
            if not settings['supports_profiles']:
                return [(None, None)]
            roots = [os.path.abspath(settings['browser_dir'])]
            files = list(cookies._find_files(roots[0], 'Cookies', Logger()))
            # The names the browser shows for its profiles, "Person 1" or "School". Only the
            # folders listed here are profiles, which leaves out the internal System Profile.
            try:
                with open(os.path.join(roots[0], 'Local State'), encoding='utf8') as state:
                    listed = json.load(state)['profile']['info_cache']
                names = {folder: info.get('name') or folder for folder, info in listed.items()}
            except Exception:
                pass
        used = {}
        for file in files:
            for root in roots:
                relative = os.path.relpath(os.path.abspath(file), root)
                if relative.startswith(os.pardir):
                    continue
                # Firefox: the folder the database sits in. Chromium: the first folder below the
                # browser's own, since the database can sit deeper, in Network.
                folder = os.path.dirname(relative)
                if browser != 'firefox':
                    folder = folder.split(os.sep)[0]
                if folder and (not names or folder in names):
                    used[folder] = max(used.get(folder, 0), os.lstat(file).st_mtime)
        if len(used) < 2:
            return [(None, None)]
        return [(folder, names.get(folder, folder)) for folder in sorted(used, key=used.get, reverse=True)]
    except Exception:
        return [(None, None)]

report = []
for browser in sys.argv[2:]:
    found = []
    errors = []
    for folder, name in profiles(browser):
        logger = Logger()
        try:
            jar = cookies.extract_cookies_from_browser(browser, folder, logger=logger)
        except Exception as error:
            errors.append(str(error))
            continue
        if logged_in({cookie.name for cookie in jar if cookie.domain.endswith(domain)}):
            shown = browser.capitalize()
            if folder is None:
                found.append((browser, shown))
            else:
                found.append((f'{browser}:{folder}', f'{shown}, profile "{name}"'))
        # Chrome without access to the keychain does not raise, it logs the error and skips the cookies
        errors.extend(logger.errors)
    if found:
        print('\n'.join('\t'.join(pair) for pair in found))
        sys.exit(0)
    status = f'cannot read cookies ({errors[0]})' if errors else f'not logged in to {label}'
    report.append(f'  {browser}: {status}')
print('\n'.join(report))
sys.exit(1)
PY
}

# djdojo.conf sits next to the script, also when djdojo is linked into PATH
conf="$(dirname "$(readlink -f "$0")")/djdojo.conf"
ytdlp=(yt-dlp --ignore-config --config-locations "$conf" --paths "$dest" "${format_args[@]}")

# Look up before starting: the playlist's name and count, the audio stream yt-dlp picks (256k
# means the Premium or Go+ login works) and the folder, computed from djdojo.conf's own template.
# The first track that can be downloaded is used, so a removed track 1 does not hide the rest.
# djdojo is for one playlist at a time, so only the first URL is shown and counted.
# Usage: lookup [yt-dlp options ...]
# Leaves the answer in $info, empty when the playlist cannot be opened.
info=
announced=no
lookup() {
  if [[ $announced == no ]]; then
    msg step "Looking up on $site_name ..."
    announced=yes
  fi
  info=$("${ytdlp[@]}" "${args[@]}" "$@" --playlist-items 1:5 --max-downloads 1 --no-warnings \
    --print $'%(playlist_title)s\t%(playlist_count)s\t%(title)s\t%(acodec)s\t%(abr).0f\t%(format_id)s\t%(ext)s\t%(filename)s' 2>/dev/null) || true
}

# Whether a lookup shows what a login is for: Premium or Go+ audio, or the uploader's own file
top_audio() {
  local abr format_id
  IFS=$'\t' read -r _ _ _ _ abr format_id _ <<< "$1" || true
  [[ ${format_id:-} == download ]] || { [[ ${abr:-} =~ ^[0-9]+$ ]] && (( abr >= 200 )); }
}

# "chrome:Profile 1" as it is shown: Chrome, profile "Profile 1"
login_name() {
  local browser=${1%%:*}
  printf '%s%s' "$(upper "${browser:0:1}")" "${browser:1}"
  if [[ $1 == *:* ]]; then
    printf ', profile "%s"' "${1#*:}"
  fi
}

# One login out of those find_login found, or none at all. The first track is looked up with each
# login, and the first that gets what a login is for wins.
# When none does and the search was djdojo's own, YouTube is asked without login. If that opens
# the playlist, the login is left out: it adds nothing to the audio, and logged-in downloads are
# the ones YouTube refuses first. A browser that was named keeps its login, which is the way to
# insist on it, and so does SoundCloud, where a login gets the uploader's file track by track,
# whatever the first track shows.
# Otherwise a login that can open the playlist goes first, since a private playlist is only seen
# by its own account, and with several of those the user chooses in a terminal.
# Usage: choose_login own|named, with find_login's lines in $found
# Sets $login, $login_label and $info, and $dropped and $keep_login when the login is left out.
choose_login() {
  local specs=() labels=() infos=() usable=() spec label i pick='' answer=''
  while IFS=$'\t' read -r spec label; do
    specs+=("$spec")
    labels+=("$label")
  done <<< "$found"
  if (( ${#specs[@]} > 1 )); then
    msg step "Found ${#specs[@]} $site_name logins, looking up which one gets $extras ..."
    announced=yes
  fi
  for i in "${!specs[@]}"; do
    lookup --cookies-from-browser "${specs[$i]}"
    infos+=("$info")
    if top_audio "$info"; then
      pick=$i
      break
    fi
    if [[ -n $info ]]; then
      usable+=("$i")
    fi
  done
  if [[ -z $pick ]]; then
    if [[ $1 == own && $site == youtube ]]; then
      lookup --no-cookies-from-browser
      if [[ -n $info ]]; then
        if (( ${#specs[@]} > 1 )); then
          dropped="none of the ${#specs[@]} logins gets $extras for the first track"
        else
          dropped="the login from ${labels[0]} gets no $extras for the first track"
        fi
        keep_login="$rerun ${specs[0]%%:*}"
        login=none
        return
      fi
    fi
    pick=${usable[0]:-0}
    if (( ${#specs[@]} > 1 && ${#usable[@]} != 1 )) && [[ -t 0 ]]; then
      msg warn "None of them gets $extras for the first track:"
      for i in "${!specs[@]}"; do
        echo "  $((i + 1))) ${labels[$i]}" >&2
      done
      read -r -p "Use [$((pick + 1))]: " answer || true
      if [[ $answer =~ ^[1-9][0-9]*$ ]] && (( answer <= ${#specs[@]} )); then
        pick=$((answer - 1))
      fi
      msg note "login=${specs[$pick]} in $(pretty "$config") skips this question."
    fi
  fi
  info=${infos[$pick]}
  login=${specs[$pick]}
  login_label=${labels[$pick]}
}

# The browsers to look through: the usual three, or the one that was named without a profile.
# A browser named with its profile, cookies from a file and nologin need no search.
search=()
whose=named
if [[ -z $login ]]; then
  search=(firefox safari chrome)
  whose=own
elif [[ $login =~ ^($browsers)$ ]]; then
  search=("$login")
fi
login_label=
dropped=
keep_login=
if (( ${#search[@]} > 0 )); then
  # A browser that was named is used as it is when nothing can be told about its profiles
  if found=$(find_login "$site" "${search[@]}"); then
    choose_login "$whose"
    if [[ $login == none ]]; then
      args+=(--no-cookies-from-browser)
      msg note "Downloading without login, since $dropped. To use the login anyway: $keep_login"
    else
      args+=(--cookies-from-browser "$login")
    fi
  elif [[ -z $login ]]; then
    msg warn "Found no browser that is logged in to $site_name. Without login $extras_long."
    cat >&2 <<EOF

$found

How to fix it:
  1. "cannot read cookies": macOS blocks the browser's data. Give Terminal Full Disk Access in
     System Settings > Privacy & Security > Full Disk Access, quit Terminal with Cmd+Q and open
     it again. Chrome also asks for access to the keychain: choose "Always Allow".
  2. "not logged in": log in to $site_url in the browser and try again.
EOF
    # In a terminal the third way is a question, with no as the default: files downloaded without
    # login are skipped on the next run, so a wrong yes costs the better audio for the whole
    # playlist. A script gets no question and has to say nologin itself.
    answer=
    if [[ -t 0 ]]; then
      echo >&2
      read -r -p "Download without login and without $extras? [y/N] " answer || true
    else
      echo "  3. Download without login and without $extras: $rerun nologin" >&2
    fi
    case $answer in
      y|Y|yes|YES) ;;
      *) exit 1 ;;
    esac
    login=none
    args+=(--no-cookies-from-browser)
    msg note "login=no in $(pretty "$config") skips this question."
  fi
fi

case $login in
  none) via="without $site_name login" ;;
  file) via="with cookies from a file" ;;
  *) via="with the $site_name login from ${login_label:-$(login_name "$login")}" ;;
esac

# Choosing between several logins has already looked up with the one that won
if [[ -z $info ]]; then
  lookup
fi
dir=
IFS=$'\t' read -r ptitle pcount title acodec abr format_id ext file <<< "$info" || true
if [[ -n ${file:-} ]]; then
  dir=$(dirname "$file")
  if [[ $ptitle != NA ]]; then
    msg step "Downloading the playlist \"$ptitle\" ($pcount tracks) as $FORMAT $via"
  else
    msg step "Downloading \"$title\" as $FORMAT $via"
  fi
  case $acodec in
    mp4a*) acodec=aac ;;
  esac
  # "download" is yt-dlp's name for the file a SoundCloud uploader offers for download
  if [[ $format_id == download ]]; then
    msg ok "Audio: the uploader's original file ($(upper "$ext"))"
  elif [[ $abr == NA ]]; then
    msg note "Audio: $acodec"
  elif [[ $abr -ge 200 ]]; then
    msg ok "Audio: $acodec ${abr}k, $premium quality"
  else
    msg note "Audio: $acodec ${abr}k, not $premium quality"
  fi
  msg note "The playlist goes into \"$(pretty "$dir")\""
else
  msg warn "Could not look it up in advance, downloading as $FORMAT $via"
fi

# The names of the audio files in the playlist's folder. The folder does not exist before the
# first file, and find must not stop the script via pipefail.
list_files() {
  if [[ -n $dir ]]; then
    (find "$dir" -maxdepth 1 -name "*.$format" 2>/dev/null || true) | sed 's|.*/||'
  fi
}

mkdir -p "$dest"
# What the summary needs afterwards: yt-dlp's ERROR lines, the files that are there already, to
# count the new ones and to tell them from the old, and the format each track's audio came from,
# for the tracks that only came as a video.
errlog=$(mktemp -t djdojo)
existing=$(mktemp -t djdojo)
picks=$(mktemp -t djdojo)
trap 'rm -f "$errlog" "$existing" "$picks"' EXIT
list_files > "$existing"
before=$(wc -l < "$existing" | tr -d ' ')

# yt-dlp says some 40 lines per track, which mean little to someone who wants the music. So
# djdojo shows one line per track and keeps everything yt-dlp said in the last run in a file,
# for when that is not enough. yt-dlp marks the moments djdojo acts on with lines of its own that
# start with $mark: the download of a track begins, its percentage, and the finished file.
mark='@@djdojo'
runlog="$(dirname "$config")/last-run.log"

# TEXT cut to at most WIDTH columns of the terminal. A character outside ASCII may take two
# columns, as a Japanese title does, and bash cannot tell, so each of them counts as two.
# Usage: fit TEXT WIDTH
fit() {
  local text=$1 width=$2 wide keep
  wide=${text//[[:ascii:]]/}
  keep=$((width - ${#wide}))
  if (( keep < width / 2 )); then
    keep=$((width / 2))
  fi
  if (( keep < 1 )); then
    text=
  elif (( ${#text} > keep )); then
    text=${text:0:keep}
  fi
  printf '%s' "$text"
}

# The three below are parts of render and use its variables.
# The number of the track at hand as "012/180 ", nothing when it has none, as a single track
track_number() {
  if [[ -n $n ]]; then
    printf '%0*d/%s ' "${#of}" "$((10#$n))" "$of"
  fi
}

# Redraws the line of the track at hand in place. Only in a terminal.
redraw() {
  if [[ $styled == yes ]]; then
    printf '\r%sdjdojo %s%s %s\033[K' "$bold$cyan" "${marks[0]}" "$plain" "$1" >&2
    live=yes
  fi
}

# The final line of a track, in place of the one that was redrawn
# Usage: settle ok|note|err TEXT
settle() {
  if [[ $live == yes ]]; then
    printf '\r\033[K' >&2
    live=no
  fi
  msg "$1" "$2"
  n='' of='' title='' head='' pct=''
}

# Turns yt-dlp's output, on stdin, into one line per track: it went well, was there already, or
# failed and why. In a terminal the line of the track at hand is kept up to date in place: its
# number as soon as yt-dlp says "Downloading item N of M", so a track that fails at once still
# has one, its title when the download begins, and the percentage after that. That line is cut
# to the terminal's width, since a line that wraps cannot be redrawn.
# Everything goes into $runlog, the ERROR lines also into $errlog and the finished tracks'
# formats into $picks, for the summary.
render() {
  local line kind a b c n='' of='' title='' head='' pct='' live=no cols=80 reason name text
  local who='^\[[^]]+\] [^:]+: (.*)$'
  if [[ $styled == yes ]]; then
    cols=$(stty size <&2 2>/dev/null | cut -d' ' -f2)
    if [[ ! $cols =~ ^[0-9]+$ ]]; then
      cols=80
    fi
  fi
  while IFS= read -r line; do
    case $line in
      "$mark"$'\t'*)
        IFS=$'\t' read -r _ kind a b c <<< "$line"
        case $kind in
          start)
            printf '%s\n' "$line" >> "$runlog"
            if [[ -z $n && $a =~ ^[0-9]+$ && $b =~ ^[0-9]+$ ]]; then
              n=$a of=$b
            fi
            title=$c
            # What is left of the width after "djdojo → ", the number and "  100%"
            text=$(track_number)
            head=$text$(fit "$title" $((cols - 16 - ${#text})))
            redraw "$head"
            ;;
          pct)
            a=${a//[^0-9.]/}
            a=${a%%.*}
            if [[ -n $head && -n $a && $a != "$pct" ]]; then
              pct=$a
              redraw "$head  $pct%"
            fi
            ;;
          *)
            printf '%s\n' "$line" >> "$runlog"
            printf '%s\t%s\t%s\n' "$a" "$b" "$c" >> "$picks"
            name=${c##*/}
            text=$(track_number)${title:-$name}
            if grep -qxF -- "$name" "$existing"; then
              settle note "$text (was there already)"
            else
              settle ok "$text"
            fi
            ;;
        esac
        ;;
      '[download] Downloading item '*)
        printf '%s\n' "$line" >> "$runlog"
        if [[ $line =~ item\ ([0-9]+)\ of\ ([0-9]+) ]]; then
          n=${BASH_REMATCH[1]} of=${BASH_REMATCH[2]} title='' head='' pct=''
          redraw "$(track_number)..."
        fi
        ;;
      ERROR:*)
        printf '%s\n' "$line" >> "$runlog"
        printf '%s\n' "$line" >> "$errlog"
        # "[youtube] abcdefghijk: Video unavailable" says which site and video, the reason is the rest
        reason=${line#ERROR: }
        if [[ $reason =~ $who ]]; then
          reason=${BASH_REMATCH[1]}
        fi
        text=$(track_number)${title:+$title }
        if [[ -n $text ]]; then
          settle err "${text}failed: $reason"
        else
          settle err "$reason"
        fi
        ;;
      *)
        printf '%s\n' "$line" >> "$runlog"
        ;;
    esac
  done
  if [[ $live == yes ]]; then
    printf '\r\033[K' >&2
  fi
}

status=0
if [[ $view == full ]]; then
  # yt-dlp sees a pipe instead of the terminal on stderr, hence --color, so ERROR still shows in
  # red. Only where djdojo colors its own lines, so saved output stays free of color codes.
  color_args=()
  if [[ -n $red ]]; then
    color_args=(--color stderr:always)
  fi
  # The format of every track goes into a file here, since stdout is the terminal's. The file to
  # write to is an output template, so a % in it is doubled.
  { "${ytdlp[@]}" "${args[@]}" ${color_args[@]+"${color_args[@]}"} \
      --print-to-file $'after_move:%(extractor_key)s\t%(vcodec)s\t%(filepath)s' "${picks//%/%%}" \
      2>&1 1>&3 | tee "$errlog" >&2; } 3>&1 || status=$?
else
  mkdir -p "$(dirname "$runlog")"
  : > "$runlog"
  # --print alone makes yt-dlp quiet, and the file is to hold everything, hence --no-quiet. The
  # progress comes on lines of its own, since render reads line by line.
  set +e
  "${ytdlp[@]}" "${args[@]}" --no-quiet --newline \
      --print "before_dl:$mark"$'\tstart\t%(playlist_autonumber)s\t%(n_entries)s\t%(title)s' \
      --print "after_move:$mark"$'\tdone\t%(extractor_key)s\t%(vcodec)s\t%(filepath)s' \
      --progress-template "download:$mark"$'\tpct\t%(progress._percent_str)s' \
      2>&1 | render
  status=${PIPESTATUS[0]}
  set -e
fi

# Covers: put each .jpg into the file of the same name and delete it. yt-dlp also fetches
# thumbnails for tracks that already exist, so files with a cover are skipped, and files
# downloaded before cover support get theirs on the next run. SoundCloud's original artwork is up
# to 3000x3000 and several MB in every file, so covers wider than 1000 px are scaled down.
# YouTube's end up at 720x720 and are copied as they are. ffmpeg marks a picture as "Other"
# unless its comment names the type.
covers=0
mux_args=(-f "$format")
if [[ $format == aiff ]]; then
  mux_args+=(-write_id3v2 1)
fi
for jpg in "$dir"/*.jpg; do
  [[ -n $dir && -f $jpg ]] || continue
  audio=${jpg%.jpg}.$format
  if [[ -f $audio && -z $(ffprobe -v error -select_streams v -show_entries stream=index -of csv=p=0 "$audio") ]]; then
    width=$(ffprobe -v error -select_streams v -show_entries stream=width -of csv=p=0 "$jpg")
    if [[ $width =~ ^[0-9]+$ ]] && (( width > 1000 )); then
      cover_args=(-c:v mjpeg -q:v 2 -vf scale=1000:-2)
    else
      cover_args=(-c:v copy)
    fi
    if ffmpeg -v error -y -i "$audio" -i "$jpg" -map 0:a -map 1 -c:a copy "${cover_args[@]}" \
        -disposition:v attached_pic -metadata:s:v comment="Cover (front)" "${mux_args[@]}" "$audio.tmp" \
        && mv "$audio.tmp" "$audio"; then
      covers=$((covers + 1))
    else
      rm -f "$audio.tmp"
    fi
  fi
  rm -f "$jpg"
done
if (( covers > 0 )); then
  msg ok "Cover added to $covers $(files "$covers")"
fi

# Tracks that YouTube only offered as a video, which djdojo.conf's format falls back to. Its sound
# is 128k AAC, about half of Premium audio, and the file is skipped on later runs, so the user is
# told which ones to delete for another try. yt-dlp notes a format for the files that were there
# already too, the one it would pick today, so only new files count.
lesser=()
if [[ -n $dir ]]; then
  while IFS=$'\t' read -r extractor vcodec path; do
    name=${path##*/}
    if [[ $extractor == Youtube && $vcodec != none && $vcodec != NA && -f $path ]] \
        && ! grep -qxF -- "$name" "$existing"; then
      lesser+=("$name")
    fi
  done < "$picks"
fi

after=$(list_files | wc -l | tr -d ' ')
failed=$(grep -c 'ERROR:' "$errlog" || true)
failed=${failed:-0}
# HTTP 403 is the site refusing the request, counted apart because the same command again rarely
# gets a different answer
refused=$(grep -c 'ERROR:.*HTTP Error 403' "$errlog" || true)
refused=${refused:-0}
if (( after >= before )); then
  summary="Done. $((after - before)) .$format $(files $((after - before))) downloaded"
  if (( before > 0 )); then
    summary+=" ($before were there already)"
  fi
else
  # Files left the folder while yt-dlp ran, for example the folder was deleted to start over, so
  # the difference no longer counts the downloads
  summary="Done. The folder has $after .$format $(files "$after"), fewer than the $before at the start, so files were removed during the run"
fi
# Green when nothing failed, red when something failed and nothing came
if (( failed == 0 )); then
  outcome=ok
elif (( after > before )); then
  outcome=warn
else
  outcome=err
fi
msg "$outcome" "$summary. $failed failed."
if [[ -n $dropped ]]; then
  msg note "Downloaded without login, since $dropped. To use the login anyway: $keep_login"
fi
if [[ -n $dir ]]; then
  msg note "The playlist is in \"$(pretty "$dir")\""
fi
if (( ${#lesser[@]} > 0 )); then
  if (( ${#lesser[@]} == 1 )); then
    msg warn "YouTube offered 1 track only as a video, so its audio is lower quality than usual:"
  else
    msg warn "YouTube offered ${#lesser[@]} tracks only as a video, so their audio is lower quality than usual:"
  fi
  for name in "${lesser[@]}"; do
    echo "  $name" >&2
  done
  msg note "To try for the usual audio, delete what is listed and run the same command again."
fi
if (( refused > 0 )); then
  # With a login yt-dlp asks the site in another way than without, so one can be refused while the
  # other works. The lookup before the download does not show it: the 403 comes on the audio itself.
  hint="$site_name refused $refused of the failed tracks (HTTP Error 403). Run \"brew upgrade\" and try the same command again"
  case $login in
    none) hint+=". If they are still refused, $site_name may be limiting your network, and waiting a few hours helps." ;;
    file) hint+=", or leave out the cookies file and with it the $extras." ;;
    *) hint+=", or download without login and without $extras: $rerun nologin" ;;
  esac
  msg warn "$hint"
fi
if (( failed > refused )); then
  msg note "Run the same command again to retry the failed tracks. Tracks that are removed or blocked on $site_name cannot be downloaded."
fi
if (( failed > 0 )) && [[ $view == calm ]]; then
  msg aside "(Everything yt-dlp said is in $(pretty "$runlog"))"
fi
exit "$status"
